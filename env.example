# CheerManager backend — copia este archivo a ".env" (junto a docker-compose.yml) y rellénalo.
# NUNCA subas el .env al repositorio.

# --- Base de datos (docker compose crea la BD "cheermanager" con estos datos) ---
DB_ROOT_PASSWORD=cambia-esto-root
DB_USERNAME=cheer
DB_PASSWORD=cambia-esto-db

# --- Seguridad: genera con:  openssl rand -base64 64   (mínimo 32 bytes) ---
JWT_SECRET=

# --- Frontend ---
# Dominio EXACTO del front (sin barra final). Varios separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Enlace que recibe el usuario al recuperar la clave: <url>?token=XXXX
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# --- Superadmin de la plataforma (se crea una sola vez; clave mínimo 10 caracteres) ---
APP_BOOTSTRAP_ADMIN_USERNAME=superadmin
APP_BOOTSTRAP_ADMIN_EMAIL=tu-correo@ejemplo.com
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Opcionales ---
# true cuando /api/consentimientos/pendientes esté en cero
CONSENTIMIENTOS_EXIGIR_SALUD=false
# false = solo facturación manual; los recordatorios automáticos se apagan con RECORDATORIOS_AUTOMATICOS=false
# FACTURACION_AUTOMATICA=true
# RECORDATORIOS_AUTOMATICOS=true
# JWT_EXPIRATION_MS=28800000
# LOG_LEVEL_APP=INFO

# --- Correo (SMTP) — se deja para el final; sin esto la recuperación de clave solo escribe el enlace en el log ---
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=no-reply@tudominio.com
