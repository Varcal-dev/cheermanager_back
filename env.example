# CheerManager backend — copia este archivo a ".env" (junto a docker-compose.yml) y rellénalo.
# NUNCA subas el .env al repositorio.

# --- Base de datos (docker compose crea la BD "cheermanager" con estos datos) ---
DB_ROOT_PASSWORD=cambia-esto-root
DB_USERNAME=cheer
DB_PASSWORD=cambia-esto-db

# --- Seguridad: genera con:  openssl rand -base64 64   (mínimo 32 bytes) ---
JWT_SECRET=

# --- Frontend ---
# Dominio EXACTO del front (sin barra final). Varios separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Enlace que recibe el usuario al recuperar la clave: <url>?token=XXXX
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# --- Superadmin de la plataforma (se crea una sola vez; clave mínimo 10 caracteres) ---
APP_BOOTSTRAP_ADMIN_USERNAME=superadmin
APP_BOOTSTRAP_ADMIN_EMAIL=tu-correo@ejemplo.com
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Opcionales ---
# true cuando /api/consentimientos/pendientes esté en cero
CONSENTIMIENTOS_EXIGIR_SALUD=false
# false = solo facturación manual; los recordatorios automáticos se apagan con RECORDATORIOS_AUTOMATICOS=false
# FACTURACION_AUTOMATICA=true
# RECORDATORIOS_AUTOMATICOS=true
# Vigencia del token en ms (por defecto 3600000 = 60 min; el front lo renueva mientras el usuario trabaja)
# JWT_EXPIRATION_MS=3600000
# LOG_LEVEL_APP=INFO
# Limite de intentos por IP (login: solo fallidos; recuperar clave: todos). Valores por defecto:
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_MAX=20            # cada RATE_LIMIT_LOGIN_VENTANA_SEG=300 (5 min)
# RATE_LIMIT_FORGOT_MAX=5            # cada RATE_LIMIT_FORGOT_VENTANA_SEG=3600 (1 h)
# RATE_LIMIT_RESET_MAX=10            # cada RATE_LIMIT_RESET_VENTANA_SEG=3600 (1 h)

# --- Pagos de suscripcion (Wompi) — sin estas tres, el club no puede pagar su suscripcion en linea ---
# Llaves de pruebas empiezan por pub_test_ (sandbox). WOMPI_REDIRECT_URL: a donde vuelve el club tras pagar (opcional).
# WOMPI_PUBLIC_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
# WOMPI_REDIRECT_URL=https://tu-frontend/suscripcion

# --- WhatsApp Business Cloud API (opcional; sin esto el canal ofrece enlaces wa.me para enviar a mano) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=recordatorio_mora
# WHATSAPP_LANGUAGE=es

# --- Bloqueo de cuenta y recuperacion de clave (valores por defecto) ---
# AUTH_MAX_LOGIN_ATTEMPTS=5
# AUTH_LOCK_DURATION_MINUTES=15
# AUTH_RESET_TOKEN_EXPIRATION_MINUTES=15

# --- Correo (SMTP) — se deja para el final; sin esto la recuperación de clave solo escribe el enlace en el log ---
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=no-reply@tudominio.com

## --- Ejecutar el backend --
## --- Crear JWT_SECRET
$bytes = New-Object byte[] 64

$rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
$rng.GetBytes($bytes)

$env:JWT_SECRET = [Convert]::ToBase64String($bytes)

$rng.Dispose()

## --- Direccio URL de la DB
$env:DB_URL="jdbc:mysql://localhost:3306/cheermanager?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true"
$env:DB_USERNAME="root"
$env:DB_PASSWORD="TU_CONTRASEÑA_MYSQL"