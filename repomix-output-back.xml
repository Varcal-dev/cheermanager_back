package com.varcal.cheermanager.Controller.Org_dep;

import com.varcal.cheermanager.Utils.RequiresPermission;

import java.time.LocalDate;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.varcal.cheermanager.DTO.Org_dep.CandidatosGrupoResponseDTO;
import com.varcal.cheermanager.DTO.Org_dep.GrupoConDeportistasDTO;
import com.varcal.cheermanager.DTO.Org_dep.GrupoEntrenamientoDTO;
import com.varcal.cheermanager.DTO.Persona.AgregarDeportistaRequest;
import com.varcal.cheermanager.DTO.Persona.AsignacionEntrenadorDTO;
import com.varcal.cheermanager.DTO.Persona.AsignacionEntrenadorResponseDTO;
import com.varcal.cheermanager.DTO.Persona.AsignacionEntrenadorUpdateDTO;
import com.varcal.cheermanager.DTO.Persona.DeportistaDTO;
import com.varcal.cheermanager.DTO.Persona.HorarioEntrenadorResponseDTO;
import com.varcal.cheermanager.Models.Org_dep.CategoriaNivel;
import com.varcal.cheermanager.Models.Org_dep.GrupoEntrenamiento;
import com.varcal.cheermanager.Models.Org_dep.TipoGrupo;
import com.varcal.cheermanager.Models.Personas.Deportista;
import com.varcal.cheermanager.Service.Org_dep.GrupoEntrenamientoService;
import com.varcal.cheermanager.repository.Org_dep.CategoriaNivelRepository;
import com.varcal.cheermanager.repository.Org_dep.GrupoEntrenamientoRepository;
import com.varcal.cheermanager.repository.Org_dep.TipoGrupoRepository;

@RestController
@RequestMapping("/api/grupos")
public class GrupoEntrenamientoController {

    @Autowired
    private GrupoEntrenamientoRepository grupoRepo;
    @Autowired
    private TipoGrupoRepository tipoGrupoRepo;
    @Autowired
    private CategoriaNivelRepository categoriaNivelRepo;
    @Autowired
    private GrupoEntrenamientoService grupoEntrenamientoService;

    @GetMapping
    @RequiresPermission("ver_grupo")
    public List<GrupoEntrenamiento> listar() {
        return grupoRepo.findAll();
    }

    @GetMapping("/{id}")
    @RequiresPermission("ver_grupo")
    public ResponseEntity<GrupoEntrenamiento> obtener(@PathVariable Integer id) {
        return grupoRepo.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

    @PostMapping
    @RequiresPermission("crear_grupo")
    public ResponseEntity<?> crear(@RequestBody GrupoEntrenamientoDTO dto) {
        Optional<TipoGrupo> tipo = tipoGrupoRepo.findById(dto.getTipoGrupoId());
        Optional<CategoriaNivel> categoria = categoriaNivelRepo.findById(dto.getCategoriaNivelId());

        if (tipo.isEmpty() || categoria.isEmpty()) {
            return ResponseEntity.badRequest().body("Tipo de grupo o categoría nivel no encontrado.");
        }

        GrupoEntrenamiento grupo = new GrupoEntrenamiento();
        grupo.setNombre(dto.getNombre());
        grupo.setTipoGrupo(tipo.get());
        grupo.setCategoriaNivel(categoria.get());

        return ResponseEntity.ok(grupoRepo.save(grupo));
    }

    @PutMapping("/{id}")
    @RequiresPermission("modificar_grupo")
    public ResponseEntity<?> actualizar(@PathVariable Integer id, @RequestBody GrupoEntrenamientoDTO dto) {
        Optional<GrupoEntrenamiento> grupoOpt = grupoRepo.findById(id);
        Optional<TipoGrupo> tipo = tipoGrupoRepo.findById(dto.getTipoGrupoId());
        Optional<CategoriaNivel> categoria = categoriaNivelRepo.findById(dto.getCategoriaNivelId());

        if (grupoOpt.isEmpty()) {
            return ResponseEntity.notFound().build();
        }

        if (tipo.isEmpty() || categoria.isEmpty()) {
            return ResponseEntity.badRequest().body("Tipo de grupo o categoría nivel no encontrado.");
        }

        GrupoEntrenamiento grupo = grupoOpt.get(); // Ya tiene ID
        grupo.setNombre(dto.getNombre());
        grupo.setTipoGrupo(tipo.get());
        grupo.setCategoriaNivel(categoria.get());

        return ResponseEntity.ok(grupoRepo.save(grupo)); // Actualiza, no crea nuevo
    }

    @DeleteMapping("/{id}")
    @RequiresPermission("eliminar_grupo")
    public ResponseEntity<Void> eliminar(@PathVariable Integer id) {
        if (!grupoRepo.existsById(id))
            return ResponseEntity.notFound().build();
        grupoRepo.deleteById(id);
        return ResponseEntity.noContent().build();
    }

    @GetMapping("/con-deportistas")
    @RequiresPermission("ver_grupo")
    public List<GrupoConDeportistasDTO> getGruposConDeportistas() {
        List<GrupoEntrenamiento> grupos = grupoRepo.findAll();

        return grupos.stream().map(grupo -> {
            GrupoConDeportistasDTO dto = new GrupoConDeportistasDTO();
            dto.setId(grupo.getId());
            dto.setNombre(grupo.getNombre());
            dto.setTipoGrupo(grupo.getTipoGrupo());
            dto.setCategoriaNivel(grupo.getCategoriaNivel());

            List<DeportistaDTO> deportistas = grupo.getDeportistas().stream()
                    .map(rel -> {
                        Deportista d = rel.getDeportista();
                        DeportistaDTO deportistaDTO = new DeportistaDTO();
                        deportistaDTO.setId(d.getId());

                        // Si tienes la persona relacionada, puedes obtener su nombre, de lo contrario
                        // puedes dejarlo como null o alguna cadena vacía.
                        deportistaDTO.setNombre(d.getPersona() != null ? d.getPersona().getNombre() : "Desconocido");
                        deportistaDTO
                                .setApellidos(d.getPersona() != null ? d.getPersona().getApellidos() : "Desconocido");
                        deportistaDTO
                                .setDireccion(d.getPersona() != null ? d.getPersona().getDireccion() : "Desconocido");
                        deportistaDTO
                                .setTelefono(d.getPersona() != null ? d.getPersona().getTelefono() : "Desconocido");
                        deportistaDTO.setFechaNacimiento(
                                d.getPersona() != null ? d.getPersona().getFechaNacimiento() : LocalDate.now());

                        deportistaDTO.setNivelActualId(d.getNivelActualId());
                        return deportistaDTO;
                    })
                    .collect(Collectors.toList());

            dto.setDeportistas(deportistas);
            return dto;
        }).collect(Collectors.toList());
    }

    // Se mantiene por compatibilidad hacia atrás (por si algún otro cliente
    // ya lo consume), pero el modal de asignación en /grupos ya no lo usa:
    // ver /candidatos, que resuelve la lista completa en una sola llamada.
    @GetMapping("/{grupoId}/verificar-elegibilidad")
    @RequiresPermission("ver_grupo")
    public ResponseEntity<Map<String, String>> verificarElegibilidad(
            @PathVariable Integer grupoId,
            @RequestParam("deportistaId") Integer deportistaId) {

        String resultado = grupoEntrenamientoService.verificarElegibilidadDeportista(grupoId, deportistaId);

        Map<String, String> response = new HashMap<>();
        response.put("resultado", resultado);

        return ResponseEntity.ok(response);
    }

    // Reemplaza al patrón N+1 (un /verificar-elegibilidad por cada
    // deportista inscrito). Devuelve en una sola llamada quiénes son
    // elegibles para este grupo y quiénes no, con motivo y el cupo del
    // grupo ya calculado.
    @GetMapping("/{grupoId}/candidatos")
    @RequiresPermission("ver_grupo")
    public ResponseEntity<?> obtenerCandidatos(@PathVariable Integer grupoId) {
        try {
            CandidatosGrupoResponseDTO candidatos = grupoEntrenamientoService.obtenerCandidatosGrupo(grupoId);
            return ResponseEntity.ok(candidatos);
        } catch (RuntimeException e) {
            return ResponseEntity.status(404).body(e.getMessage());
        }
    }

    @PostMapping("/{grupoId}/agregar-deportistas")
    @RequiresPermission("modificar_grupo")
    public ResponseEntity<?> agregarDeportistaAGrupo(
            @PathVariable Integer grupoId,
            @RequestBody AgregarDeportistaRequest request) {
        try {
            String resultado = grupoEntrenamientoService.agregarDeportistaAGrupo(request.getDeportistaId(), grupoId,
                    request.getObservaciones());
            return ResponseEntity.ok(resultado);
        } catch (RuntimeException e) {
            return ResponseEntity.badRequest().body(e.getMessage());
        }
    }

    // Cierra la membresía activa del deportista en este grupo (fechaFin =
    // hoy). No la borra: conserva el historial y libera al deportista para
    // que vuelva a aparecer como candidato de cualquier grupo.
    @DeleteMapping("/{grupoId}/deportistas/{deportistaId}")
    @RequiresPermission("modificar_grupo")
    public ResponseEntity<?> quitarDeportista(@PathVariable Integer grupoId, @PathVariable Integer deportistaId) {
        try {
            String resultado = grupoEntrenamientoService.quitarDeportistaDeGrupo(grupoId, deportistaId);
            return ResponseEntity.ok(resultado);
        } catch (RuntimeException e) {
            return ResponseEntity.badRequest().body(e.getMessage());
        }
    }

    @PostMapping("/{grupoId}/asignar-entrenadores")
    @RequiresPermission("modificar_grupo")
    public ResponseEntity<?> asignarEntrenadorAGrupo(
            @PathVariable int grupoId,
            @RequestBody AsignacionEntrenadorDTO dto) {
        dto.setGrupoId(grupoId); // asegúrate de que coincida
        try {
            String respuesta = grupoEntrenamientoService.asignarEntrenadorAGrupo(dto);
            return ResponseEntity.ok(respuesta);
        } catch (RuntimeException e) {
            return ResponseEntity.badRequest().body(e.getMessage());
        }
    }

    // ===== Historial de asignaciones entrenador-grupo =====
    // (panel "Historial de Asignación a Grupos" en entrenadores/page.tsx)

    @GetMapping("/entrenadores/{entrenadorId}/asignaciones")
    @RequiresPermission("ver_grupo")
    public ResponseEntity<List<AsignacionEntrenadorResponseDTO>> listarAsignacionesDeEntrenador(
            @PathVariable Integer entrenadorId) {
        return ResponseEntity.ok(grupoEntrenamientoService.listarAsignacionesPorEntrenador(entrenadorId));
    }

    // Panel "Horarios" en entrenadores/page.tsx — ver el comentario en
    // GrupoEntrenamientoService.listarHorarioPorEntrenador() para el porqué
    // no es una entidad propia.
    @GetMapping("/entrenadores/{entrenadorId}/horario")
    @RequiresPermission("ver_grupo")
    public ResponseEntity<List<HorarioEntrenadorResponseDTO>> listarHorarioDeEntrenador(
            @PathVariable Integer entrenadorId) {
        return ResponseEntity.ok(grupoEntrenamientoService.listarHorarioPorEntrenador(entrenadorId));
    }

    @PutMapping("/asignaciones-entrenador/{asignacionId}")
    @RequiresPermission("modificar_grupo")
    public ResponseEntity<?> actualizarAsignacionEntrenador(
            @PathVariable Integer asignacionId,
            @RequestBody AsignacionEntrenadorUpdateDTO dto) {
        try {
            return ResponseEntity.ok(grupoEntrenamientoService.actualizarAsignacionEntrenador(asignacionId, dto));
        } catch (RuntimeException e) {
            return ResponseEntity.badRequest().body(e.getMessage());
        }
    }

    // No borra el registro — cierra la asignación con fechaFin = hoy, igual
    // que /grupoId/deportistas/deportistaId. Conserva el historial de quién
    // entrenó a quién y cuándo.
    @DeleteMapping("/asignaciones-entrenador/{asignacionId}")
    @RequiresPermission("modificar_grupo")
    public ResponseEntity<?> finalizarAsignacionEntrenador(@PathVariable Integer asignacionId) {
        try {
            String resultado = grupoEntrenamientoService.finalizarAsignacionEntrenador(asignacionId);
            return ResponseEntity.ok(resultado);
        } catch (RuntimeException e) {
            return ResponseEntity.badRequest().body(e.getMessage());
        }
    }

}
