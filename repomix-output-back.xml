    // Método para eliminar un deportista
    // @Transactional: cambia estado + escribe historial + desactiva usuario.
    // Si falla el último paso, no queremos que el deportista quede marcado como
    // "Retirado" con su usuario todavía activo.
    @Transactional
    public void eliminarDeportista(Integer deportistaId) {

        Deportista deportista = deportistaRepository.findById(deportistaId)
                .orElseThrow(() -> new RuntimeException("Deportista no encontrado"));

        EstadoPersona estadoRetirado = estadoRetirado();

        // Registrar el cambio de estado en el historial
        registrarCambioEstado(deportista, deportista.getEstado(), estadoRetirado, null,
                "Deportista retirado del club");

        deportista.setEstado(estadoRetirado);
        deportistaRepository.save(deportista);

        // Regla de negocio: al retirar se CIERRA la inscripcion (deja de generar cobros mensuales)
        // y se SACA del grupo (membresia con fechaFin = hoy, se conserva el historial).
        // Las facturas ya emitidas se dejan tal cual: la deuda pendiente sigue visible en cartera.
        for (Inscripcion inscripcion : inscripcionRepository.findByDeportistaIdAndEstado(
                deportista.getId(), Inscripcion.EstadoInscripcion.Activa)) {
            inscripcion.setEstado(Inscripcion.EstadoInscripcion.Inactiva);
            inscripcionRepository.save(inscripcion);
        }
        LocalDate hoy = LocalDate.now();
        for (DeportistaPerteneceGrupo membresia : deportistaPerteneceGrupoRepository
                .findByDeportistaIdAndFechaFinIsNull(deportista.getId())) {
            membresia.setFechaFin(hoy);
            deportistaPerteneceGrupoRepository.save(membresia);
        }

        // Desactivar usuario (si lo tiene: no todos los deportistas tienen usuario)
        userRepository.findByPersona(deportista.getPersona()).ifPresent(usuario -> {
            usuario.setActivo(false);
            userRepository.save(usuario);
        });
    }

    /** Resultado de reactivar a un deportista retirado. */
    public record ReactivacionResultado(Integer deportistaId, String estado, boolean usuarioReactivado,
            boolean requiereMatricula) {
    }

    /**
     * Reactivacion de un deportista RETIRADO (el retiro fue por error o vuelve al club).
     *  - Estado -> "Activo", con registro en el historial de estados (y el motivo, si se indica).
     *  - Su usuario (si tenia) se vuelve a activar; conserva su clave.
     *  - NO se reabre la inscripcion ni se devuelve al grupo: el retiro cerro la inscripcion y la membresia
     *    del grupo (con historial) y una inscripcion implica cobros, asi que se hace con una matricula nueva
     *    (asistente de Inscripciones o solicitud desde el portal). Las facturas del retiro siguen como estaban.
     */
    @Transactional
    public ReactivacionResultado reactivarDeportista(Integer deportistaId, String motivo) {
        Deportista deportista = deportistaRepository.findById(deportistaId)
                .orElseThrow(() -> new RuntimeException("Deportista no encontrado"));

        EstadoPersona retirado = estadoRetirado();
        if (deportista.getEstado() == null || !retirado.getId().equals(deportista.getEstado().getId())) {
            throw new RuntimeException("Solo se puede reactivar a un deportista en estado Retirado");
        }

        EstadoPersona activo = estadoPersonaRepository.findByEstado("Activo")
                .orElseThrow(() -> new RuntimeException("Estado 'Activo' no encontrado en el catalogo estados_persona"));

        String m = (motivo == null || motivo.isBlank()) ? "Deportista reactivado" : "Deportista reactivado: " + motivo.trim();
        if (m.length() > 255) {
            m = m.substring(0, 255);
        }
        registrarCambioEstado(deportista, deportista.getEstado(), activo, null, m);
        deportista.setEstado(activo);
        deportistaRepository.save(deportista);

        int usuarios = userRepository.reactivarPorPersona(deportista.getPersona().getId(),
                com.varcal.cheermanager.tenant.TenantContext.require());

        boolean tieneInscripcionActiva = !inscripcionRepository
                .findByDeportistaIdAndEstado(deportista.getId(), Inscripcion.EstadoInscripcion.Activa).isEmpty();
        return new ReactivacionResultado(deportista.getId(), activo.getEstado(), usuarios > 0, !tieneInscripcionActiva);
    }

    // Método para registrar un entrenador
    // ==========================================
    // Este método recibe un DTO de Entrenador y lo convierte a una entidad
    // Entrenador
    // @Transactional: igual que registrarDeportista, son tres guardados ligados
    // (Persona + Entrenador + Usuario) que deben ser atómicos.
    @Transactional
    public Entrenador registrarEntrenador(EntrenadorDTO entrenadorDTO) {
        // Registrar la persona
        Persona persona = new Persona();
        persona.setNombre(entrenadorDTO.getNombre());
        persona.setApellidos(entrenadorDTO.getApellidos());
        persona.setDireccion(entrenadorDTO.getDireccion());
        persona.setTelefono(entrenadorDTO.getTelefono());
        persona.setFechaNacimiento(entrenadorDTO.getFechaNacimiento());
        referencias.exigirGenero(entrenadorDTO.getGeneroId());
        persona.setGeneroId(entrenadorDTO.getGeneroId());
        Persona personaGuardada = personaRepository.save(persona);

        // Registrar el entrenador
        Entrenador entrenador = new Entrenador();
        entrenador.setPersona(personaGuardada);
        entrenador.setFechaContratacion(entrenadorDTO.getFechaContratacion());
        entrenador.setFechaContratacion(entrenadorDTO.getFechaContratacion());
        entrenador.setEspecializacion(entrenadorDTO.getEspecializacion());
        // entrenador.setEstadoId(entrenadorDTO.getEstadoId());
        // Setear el estado usando la relación
        EstadoPersona estado = estadoPersonaRepository.findById(entrenadorDTO.getEstadoId())
                .orElseThrow(() -> new RuntimeException("Estado no encontrado"));
        entrenador.setEstado(estado);
        Entrenador entrenadorGuardado = entrenadorRepository.save(entrenador);

        // Registrar al entrenador como usuario
        String username = generarUsername(
                entrenadorDTO.getNombre(),
                entrenadorDTO.getApellidos());
        String email = username + "@cheermanager.com"; // Generar un email ficticio o usar uno proporcionado
        String password = ClaveTemporal.generar(); // aleatoria; el admin entrega una temporal con /clave-temporal
        Rol rolEntrenador = rolRepository.findByNombre("Entrenador")
                .orElseThrow(() -> new RuntimeException("El rol 'Entrenador' no existe en la base de datos"));

        // Antes se calculaban username/email/password/rol pero NUNCA se creaba el usuario:
        // el entrenador quedaba sin acceso al sistema.
        registrarUsuario(personaGuardada, username, email, password, rolEntrenador.getId(), true);

        return entrenadorGuardado;
    }

    // Método para modificar un entrenador
    // @Transactional: actualiza Persona y Entrenador en el mismo flujo.
    @Transactional
    public Entrenador modificarEntrenador(Integer id, EntrenadorDTO dto) {

        return entrenadorRepository.findById(id).map(entrenador -> {

            Persona persona = entrenador.getPersona();

            if (dto.getNombre() != null && !dto.getNombre().isBlank()) {
                persona.setNombre(dto.getNombre());
            }

            if (dto.getApellidos() != null && !dto.getApellidos().isBlank()) {
                persona.setApellidos(dto.getApellidos());
            }

            if (dto.getDireccion() != null) {
                persona.setDireccion(dto.getDireccion());
            }

            if (dto.getTelefono() != null) {
                persona.setTelefono(dto.getTelefono());
            }

            if (dto.getFechaNacimiento() != null) {
                persona.setFechaNacimiento(dto.getFechaNacimiento());
            }

            if (dto.getGeneroId() != null) {
                referencias.exigirGenero(dto.getGeneroId());
                persona.setGeneroId(dto.getGeneroId());
            }

            personaRepository.save(persona);

            if (dto.getFechaContratacion() != null) {
                entrenador.setFechaContratacion(dto.getFechaContratacion());
            }

            if (dto.getEstadoId() != null) {
                EstadoPersona estado = estadoPersonaRepository.findById(dto.getEstadoId())
                        .orElseThrow(() -> new RuntimeException("Estado no encontrado"));
                entrenador.setEstado(estado);
            }

            return entrenadorRepository.save(entrenador);
        }).orElseThrow(() -> new RuntimeException("Entrenador no encontrado"));
    }

    // Método para listar todos los entrenadores
    public List<Entrenador> listarEntrenadores() {
        return entrenadorRepository.findAll();
    }

    // Método para eliminar un entrenador
    // @Transactional: cambia estado de Entrenador + desactiva su Usuario.
    @Transactional
    public void eliminarEntrenador(Integer id) {
        Entrenador entrenador = entrenadorRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Entrenador no encontrado"));

        entrenador.setEstado(estadoRetirado());
        entrenadorRepository.save(entrenador);

        // Desactivar usuario (si lo tiene)
        userRepository.findByPersona(entrenador.getPersona()).ifPresent(usuario -> {
            usuario.setActivo(false);
            userRepository.save(usuario);
        });
    }


}
