# Ejemplo de crontab del servidor (crontab -e). Ajusta rutas y usuario.
# Las claves y ALERTA_* van en un archivo con permisos 600, p. ej. /etc/cheermanager/ops.env, que se carga con "set -a".
SHELL=/bin/bash
OPS=/opt/cheermanager/back/ops
ENV=/etc/cheermanager/ops.env

# Respaldo diario 2:30 a.m.
30 2 * * *   set -a; . $ENV; set +a; $OPS/backup.sh >> /var/log/cheermanager-backup.log 2>&1
# Prueba de restauracion, el dia 1 de cada mes 4:00 a.m.
0 4 1 * *    set -a; . $ENV; set +a; $OPS/probar_restauracion.sh >> /var/log/cheermanager-restauracion.log 2>&1
# Vigilante cada 5 minutos
*/5 * * * *  set -a; . $ENV; set +a; $OPS/verificar_salud.sh >> /var/log/cheermanager-salud.log 2>&1
