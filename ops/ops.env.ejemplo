# Copiar a /etc/cheermanager/ops.env  (sudo mkdir -p /etc/cheermanager; sudo chmod 600 /etc/cheermanager/ops.env)
# Lo cargan los cron de ops/crontab.ejemplo. Nunca va al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cheermanager
DB_USER=backup
DB_PASSWORD=cambia-esto
BACKUP_DIR=/var/backups/cheermanager
KEEP_DAYS=14

# Copia FUERA del servidor (rclone config primero). Ej.: gdrive:cheermanager-respaldos
RCLONE_REMOTE=

# Alertas (elige una)
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT_ID=
# ALERTA_WEBHOOK_URL=
