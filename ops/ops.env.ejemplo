# Copiar a /etc/cheermanager/ops.env  (sudo mkdir -p /etc/cheermanager; sudo chmod 600 /etc/cheermanager/ops.env)
# Lo cargan los cron de ops/crontab.ejemplo. Nunca va al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cheermanager
DB_USER=backup
DB_PASSWORD=cambia-esto
BACKUP_DIR=/var/backups/cheermanager
KEEP_DAYS=14

# Copia FUERA del servidor (rclone config primero). Ej.: gdrive:cheermanager-respaldos
RCLONE_REMOTE=

# Cifrado de los respaldos con age (apt install age). Aqui va SOLO la clave PUBLICA (empieza por age1...);
# la llave PRIVADA NO va en el servidor. Varias claves separadas por espacio (p. ej. principal + repuesto).
# Con RCLONE_REMOTE definido es OBLIGATORIO: sin esto el respaldo falla y avisa. Ver docs/GUIA_OPERACION.md.
BACKUP_AGE_RECIPIENT=
# Solo para restaurar o probar a mano, en TU computador (nunca en el servidor): ruta a la llave privada.
# BACKUP_AGE_IDENTITY=/ruta/a/llave-privada.txt
# Emergencia, no recomendado: permite subir respaldos SIN cifrar a RCLONE_REMOTE.
# BACKUP_ALLOW_PLAINTEXT=1

# Respaldo de fotos y documentos (ops/backup_uploads.sh). BACKUP_UPLOADS=1 hace que el vigilante avise si falta o esta viejo.
# Por defecto lee del contenedor "api" del docker-compose del repo; con UPLOADS_DIR lee de una carpeta del servidor.
# BACKUP_UPLOADS=1
# COMPOSE_DIR=/opt/cheermanager/back
# UPLOADS_SERVICE=api
# UPLOADS_PATH=/data/uploads
# UPLOADS_DIR=/ruta/a/uploads

# Alertas (elige una)
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT_ID=
# ALERTA_WEBHOOK_URL=
